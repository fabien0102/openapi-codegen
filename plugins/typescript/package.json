{
  "name": "@openapi-codegen/typescript",
  "version": "12.1.0",
  "description": "OpenAPI Codegen typescript generators",
  "keywords": [
    "codegen",
    "openapi",
    "plugin",
    "typescript"
  ],
  "license": "MIT",
  "author": "Fabien Bernard",
  "repository": {
    "url": "git+https://github.com/fabien0102/openapi-codegen.git",
    "directory": "plugins/typescript"
  },
  "homepage": "https://github.com/fabien0102/openapi-codegen/tree/main/plugins/typescript#readme",
  "bugs": {
    "url": "https://github.com/fabien0102/openapi-codegen/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts --no-dts && tsc -p tsconfig.package.json --emitDeclarationOnly --declaration --outDir dist && cp dist/index.d.ts dist/index.d.mts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "case-anything": "^3.1.7",
    "lodash-es": "^4.18.1",
    "openapi3-ts": "^4.6.1",
    "pluralize": "^8.0.0",
    "typescript": "7.1.0-beta"
  },
  "type": "module",
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/pluralize": "^0.0.33",
    "oxfmt": "^0.75.0"
  }
}
