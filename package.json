{
  "name": "openapi-codegen",
  "version": "0.0.1",
  "private": true,
  "description": "OpenAPI code generator framework",
  "license": "MIT",
  "author": "Fabien Bernard",
  "repository": "https://github.com/fabien0102/openapi-codegen",
  "scripts": {
    "test": "vp test",
    "check": "pnpm /^check:.*/",
    "check:types": "tsc --noEmit",
    "check:lint": "vp lint .",
    "check:fmt": "vp fmt --check .",
    "check:knip": "knip --workspace cli --workspace plugins/*",
    "fix": "pnpm /^fix:.*/",
    "fix:lint": "vp lint --fix .",
    "fix:fmt": "vp fmt .",
    "build": "pnpm /^build:.*/",
    "build:plugin:ts": "pnpm --filter=@openapi-codegen/typescript build",
    "build:cli": "pnpm --filter=@openapi-codegen/cli build",
    "all-contrib": "all-contributors",
    "prepare": "vp config",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "all-contributors-cli": "^6.26.1",
    "knip": "^6.43.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
